# pnpm 10 turns ignored build scripts into hard install errors by default
# (strict-dep-builds=true). Combined with `pnpm.onlyBuiltDependencies` in
# package.json this should resolve, but pnpm versions older than 10.10
# do not honour the package-level whitelist consistently in CI runners
# that re-resolve the lockfile, so we disable the strict gate here as
# belt-and-braces. The whitelist in package.json still expresses intent.
strict-dep-builds=false
