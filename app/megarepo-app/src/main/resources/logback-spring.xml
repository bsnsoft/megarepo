<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Console appender (always active, suitable for Docker/K8s stdout) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
        File logging: activated when MEGAREPO_LOG_FILE env var is set.
        Example: MEGAREPO_LOG_FILE=logs/megarepo.log
        Rolling: daily rotation, max 100MB per file, 7 days retention, 1GB total cap.

        To enable: set the environment variable before starting the application.
    -->
    <springProfile name="logfile">
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${MEGAREPO_LOG_FILE:-logs/megarepo.log}</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${MEGAREPO_LOG_FILE:-logs/megarepo.log}.%d{yyyy-MM-dd}.%i</fileNamePattern>
                <maxFileSize>100MB</maxFileSize>
                <maxHistory>7</maxHistory>
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
