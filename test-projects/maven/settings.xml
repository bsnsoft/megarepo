<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0
                              https://maven.apache.org/xsd/settings-1.2.0.xsd">

    <servers>
        <server>
            <id>megarepo</id>
            <username>admin</username>
            <password>admin123</password>
        </server>
        <server>
            <id>megarepo-releases</id>
            <username>admin</username>
            <password>admin123</password>
        </server>
        <server>
            <id>megarepo-snapshots</id>
            <username>admin</username>
            <password>admin123</password>
        </server>
    </servers>

    <mirrors>
        <mirror>
            <id>megarepo</id>
            <mirrorOf>*</mirrorOf>
            <url>http://localhost:8081/repository/maven-central-proxy/</url>
        </mirror>
    </mirrors>

    <profiles>
        <profile>
            <id>megarepo</id>
            <repositories>
                <repository>
                    <id>megarepo</id>
                    <url>http://localhost:8081/repository/maven-central-proxy/</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>megarepo</id>
                    <url>http://localhost:8081/repository/maven-central-proxy/</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>

    <activeProfiles>
        <activeProfile>megarepo</activeProfile>
    </activeProfiles>

</settings>
