# =============================================================================
# MegaRepo — Environment Configuration
# =============================================================================
# Copy this file to .env and change the values marked CHANGE-ME.
#
#   cp .env.example .env
#   $EDITOR .env
#   docker compose -f docker-compose.prod.yml up -d
# =============================================================================

# --- REQUIRED: You MUST change these before starting ---

# PostgreSQL password (used by both the database and MegaRepo)
POSTGRES_PASSWORD=CHANGE-ME-use-a-strong-random-password

# JWT signing secret (>= 32 characters, random)
# Generate one with:  openssl rand -base64 48
MEGAREPO_JWT_SECRET=CHANGE-ME-generate-with-openssl-rand-base64-48

# --- Optional settings ---

# Port MegaRepo listens on (host side)
# MEGAREPO_PORT=8080

# Initial admin password (only used on first startup, change via UI afterwards)
# MEGAREPO_ADMIN_PASSWORD=admin123

# Maximum artifact upload size
# MEGAREPO_MAX_UPLOAD_SIZE=1GB

# Proxy repository timeouts
# MEGAREPO_PROXY_CONNECT_TIMEOUT=10s
# MEGAREPO_PROXY_READ_TIMEOUT=30s

# Memory limits (Docker resource constraints)
# MEGAREPO_MEMORY_LIMIT=1g
# POSTGRES_MEMORY_LIMIT=512m

# JVM options (advanced — the defaults are fine for most setups)
# JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC
